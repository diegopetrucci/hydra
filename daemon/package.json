{
  "name": "@hydra/daemon",
  "version": "0.1.0",
  "description": "Hydra local daemon – pi-durable harness with JSON-lines protocol",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/daemon.mjs --external:node:* --external:undici --external:linkedom --external:turndown --external:@mozilla/readability --external:defuddle",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@diegopetrucci/pi-web-access": "0.29.2",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.25.5",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
